# Copy this file to .env and fill in your values.
# .env is never committed — it stays local only.

# Optional: Gmail SMTP for emailing the daily report.
# GMAIL_APP_PASSWORD is a Google App Password, not your account password.
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
REPORT_TO=your-email@gmail.com

# Optional: Telegram bot for sending the daily report to Telegram.
# Create a bot via @BotFather and get your chat ID via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
